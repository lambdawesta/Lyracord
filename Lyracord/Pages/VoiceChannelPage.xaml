<Page
    x:Class="Unicord.Universal.Pages.VoiceChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:voice="using:Unicord.Universal.Models.Voice"
    mc:Ignorable="d"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar: on phones the sidebar and its voice panel are hidden behind this page -->
        <Grid Padding="4,6,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="Back_Click" Background="Transparent" Foreground="White" Padding="10,8">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Foreground="#FF9A9A9A" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="AudioRouteButton" Click="AudioRoute_Click" Background="Transparent" Foreground="White" Padding="10,8" Margin="2,0" Visibility="Collapsed">
                    <FontIcon x:Name="AudioRouteIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="16"/>
                </Button>
                <ToggleButton x:Name="MuteToggle" Click="Mute_Click" Foreground="White" Padding="10,8" Margin="2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEC54;" FontSize="16"/>
                </ToggleButton>
                <ToggleButton x:Name="DeafenToggle" Click="Deafen_Click" Foreground="White" Padding="10,8" Margin="2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74F;" FontSize="16"/>
                </ToggleButton>
                <Button x:Name="VoiceSettingsButton" Click="Settings_Click" Background="Transparent" Foreground="White" Padding="10,8" Margin="2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="16"/>
                </Button>
                <Button x:Name="DisconnectButton" Click="Disconnect_Click" Background="#FFED4245" Foreground="White" Padding="10,8" Margin="2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE778;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <GridView x:Name="TilesView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TilesView_ItemClick"
                  Padding="12,0,12,12" SizeChanged="TilesView_SizeChanged">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="voice:VoiceTile">
                    <!-- Metro: square tiles. Never Grid/Control.CornerRadius here: 1809+, phones run 1709 -->
                    <Border Background="{x:Bind Background}">
                    <Grid>
                        <!-- person: avatar in the middle -->
                        <Grid Visibility="{x:Bind PersonVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="88" Height="88" Fill="#33FFFFFF"/>
                            <Ellipse Width="88" Height="88">
                                <Ellipse.Fill>
                                    <ImageBrush Stretch="UniformToFill">
                                        <ImageBrush.ImageSource>
                                            <BitmapImage UriSource="{x:Bind Member.AvatarUri}" DecodePixelWidth="88" DecodePixelHeight="88" DecodePixelType="Logical"/>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <!-- stream: watch button -->
                        <StackPanel Visibility="{x:Bind StreamVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="32" Foreground="#FFB9BBBE" Margin="0,0,0,12"/>
                            <Button Command="{x:Bind WatchCommand}" Background="#FF2B2D31" Foreground="White" Padding="16,8">
                                <TextBlock x:Uid="/Metro/WatchStreamText" Text="Смотреть стрим" FontSize="15"/>
                            </Button>
                        </StackPanel>

                        <!-- name chip -->
                        <Border Background="#99000000" Padding="8,3" Margin="10"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Visibility="{x:Bind StreamVisibility}" FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="12" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Bind Member.DisplayName}" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center"/>
                                <Border Visibility="{x:Bind Member.GuildTagVisibility}"
                                        Background="#CC1E1E1E"
                                        BorderBrush="#FF5A5A5A"
                                        BorderThickness="1"
                                        Padding="4,1,5,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="12" Height="12" Margin="0,0,3,0"
                                               VerticalAlignment="Center" Stretch="Uniform"
                                               Visibility="{x:Bind Member.GuildTagBadgeVisibility}"
                                               Source="{Binding Member.GuildTagBadgeUrl}"/>
                                        <TextBlock Text="{x:Bind Member.GuildTag}"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="10"
                                                   CharacterSpacing="40"
                                                   Foreground="#FFEBEBEB"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Border>
                                <FontIcon Visibility="{x:Bind Member.MutedVisibility}" FontFamily="Segoe MDL2 Assets" Glyph="&#xEC54;" FontSize="12" Foreground="White" Margin="6,0,0,0"/>
                                <FontIcon Visibility="{x:Bind Member.DeafenedVisibility}" FontFamily="Segoe MDL2 Assets" Glyph="&#xE74F;" FontSize="12" Foreground="White" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- speaking: green frame around the tile -->
                        <Border Visibility="{x:Bind Member.SpeakingVisibility, Mode=OneWay}" BorderBrush="#FF23A55A" BorderThickness="3"
                                IsHitTestVisible="False"/>
                    </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
