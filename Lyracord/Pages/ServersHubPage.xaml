<Page
    x:Class="Unicord.Universal.Pages.ServersHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <!-- "servers · direct · friends" in the Windows Phone hub style: servers as square tiles, conversations and
         friends as lists with square photos. Square corners only (Grid/Control.CornerRadius need 1809). -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HubBackground" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HubForeground" Color="#FFFFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HubBackground" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubForeground" Color="#FF000000"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource HubBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="21,16,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="lyracord" FontFamily="Segoe UI" FontWeight="Light" FontSize="48"
                       Foreground="{ThemeResource HubForeground}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,6">
                <Button x:Name="SearchToggleButton"
                        Click="SearchToggle_Click"
                        Background="Transparent"
                        Foreground="{ThemeResource HubForeground}"
                        BorderThickness="0"
                        Width="44" Height="44"
                        Padding="0"
                        Margin="0,0,2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="20"/>
                </Button>
                <Button x:Name="AddFriendButton"
                        Click="AddFriend_Click"
                        Background="Transparent"
                        Foreground="{ThemeResource HubForeground}"
                        BorderThickness="0"
                        Width="44" Height="44"
                        Padding="0"
                        Margin="0,0,2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8FA;" FontSize="20"/>
                </Button>
                <Button x:Name="JoinServerButton"
                        Click="JoinServer_Click"
                        Background="Transparent"
                        Foreground="{ThemeResource HubForeground}"
                        BorderThickness="0"
                        Width="44" Height="44"
                        Padding="0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="SearchBar" Grid.Row="1" Visibility="Collapsed" Margin="21,8,21,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     BorderThickness="2"
                     BorderBrush="{ThemeResource HubForeground}"
                     Background="Transparent"
                     Foreground="{ThemeResource HubForeground}"
                     FontSize="16"
                     TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1"
                    Click="CloseSearch_Click"
                    Background="Transparent"
                    Foreground="{ThemeResource HubForeground}"
                    BorderBrush="{ThemeResource HubForeground}"
                    BorderThickness="0,2,2,2"
                    Width="42"
                    VerticalAlignment="Stretch"
                    Padding="0">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="14"/>
            </Button>
        </Grid>

        <Pivot x:Name="MainPivot" Grid.Row="2" Margin="12,0,12,0">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontWeight="Light" FontSize="30"/>
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <PivotItem x:Uid="/Metro/ServersTabServers" Header="серверы" Margin="12,8,12,0">
                <ScrollViewer x:Name="ServersScroll" VerticalScrollBarVisibility="Auto" SizeChanged="ServersScroll_SizeChanged">
                    <StackPanel Margin="0,0,0,24">
                        <VariableSizedWrapGrid x:Name="ServersGrid" Orientation="Horizontal"/>
                        <TextBlock x:Name="ServersEmptyText" Visibility="Collapsed" FontSize="18" Margin="4,12,0,0"
                                   Foreground="{ThemeResource HubForeground}" Opacity="0.6"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem x:Uid="/Metro/ServersTabDirect" Header="личные" Margin="12,8,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DirectList" Margin="0,0,0,24"/>
                </ScrollViewer>
            </PivotItem>
            <PivotItem x:Uid="/Metro/ServersTabFriends" Header="друзья" Margin="12,8,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FriendsList" Margin="0,0,0,24"/>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
