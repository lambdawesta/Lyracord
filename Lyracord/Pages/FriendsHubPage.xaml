<Page
    x:Class="Unicord.Universal.Pages.FriendsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unicord.Universal.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Unicord.Universal.Models"
    xmlns:relationships="using:Unicord.Universal.Models.Relationships"
    xmlns:presence="using:Unicord.Universal.Controls.Presence"
    xmlns:converters="using:Unicord.Universal.Converters"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <!-- Friends in the style of the Windows Phone People hub: lowercase title and pivot headers, square photos,
         a thin status bar beside each photo. Square corners only (Grid/Control.CornerRadius need 1809). -->
    <Page.DataContext>
        <models:FriendsPageViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HubBackground" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HubForeground" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubSecondary" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="HubPhotoBackground" Color="#FF262626"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HubBackground" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubForeground" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HubSecondary" Color="#FF6B6B6B"/>
                    <SolidColorBrush x:Key="HubPhotoBackground" Color="#FFE0E0E0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:StatusBrushConverter x:Key="StatusBrush"/>

            <Style x:Key="PersonItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>

            <DataTemplate x:Key="PersonTemplate" x:DataType="relationships:RelationshipViewModel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- status: green online, yellow idle, red do not disturb, nothing offline -->
                    <Rectangle Fill="{x:Bind User.Presence.Status, Converter={StaticResource StatusBrush}, Mode=OneWay, FallbackValue={x:Null}}"/>
                    <Grid Grid.Column="1" Width="64" Height="64" Background="{ThemeResource HubPhotoBackground}">
                        <!-- AvatarUrl already asks the CDN for a 64 px picture -->
                        <Image Source="{Binding User.AvatarUrl}" Stretch="UniformToFill"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind User.DisplayName}" FontSize="22" FontFamily="Segoe UI" FontWeight="SemiLight"
                                       Foreground="{ThemeResource HubForeground}" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1"
                                    Visibility="{x:Bind User.GuildTagVisibility, Mode=OneWay}"
                                    Background="{ThemeResource GuildTagBackgroundBrush}"
                                    BorderBrush="{ThemeResource GuildTagBorderBrush}"
                                    BorderThickness="1"
                                    Padding="5,2,6,2"
                                    Margin="8,2,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="15" Height="15" Margin="0,0,4,0"
                                           VerticalAlignment="Center" Stretch="Uniform"
                                           Visibility="{x:Bind User.GuildTagBadgeVisibility, Mode=OneWay}"
                                           Source="{Binding User.GuildTagBadgeUrl}"/>
                                    <TextBlock Text="{x:Bind User.GuildTag, Mode=OneWay}"
                                               FontFamily="Segoe UI"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               CharacterSpacing="40"
                                               Foreground="{ThemeResource GuildTagForegroundBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <presence:InlinePresenceControl x:Name="PresenceText" x:Load="{x:Bind converters:Static.NotNull(User.Presence)}" x:Phase="2"
                                                        Presence="{x:Bind User.Presence}" Foreground="{ThemeResource HubSecondary}"
                                                        TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="PendingTemplate" x:DataType="relationships:RelationshipViewModel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="{ThemeResource SystemControlForegroundAccentBrush}"/>
                    <Grid Grid.Column="1" Width="64" Height="64" Background="{ThemeResource HubPhotoBackground}">
                        <Image Source="{Binding User.AvatarUrl}" Stretch="UniformToFill"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind User.DisplayName}" FontSize="20" FontFamily="Segoe UI" FontWeight="SemiLight"
                                   Foreground="{ThemeResource HubForeground}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind RequestLabel}" FontSize="13" Foreground="{ThemeResource HubSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="AcceptRequest_Click"
                                Tag="{x:Bind Id}"
                                Visibility="{x:Bind AcceptVisibility}"
                                Background="Transparent"
                                Foreground="{ThemeResource HubForeground}"
                                BorderBrush="{ThemeResource HubForeground}"
                                BorderThickness="2"
                                Width="40" Height="40"
                                Padding="0"
                                Margin="0,0,8,0">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="16"/>
                        </Button>
                        <Button Click="DeclineRequest_Click"
                                Tag="{x:Bind Id}"
                                Background="Transparent"
                                Foreground="{ThemeResource HubSecondary}"
                                BorderBrush="{ThemeResource HubSecondary}"
                                BorderThickness="2"
                                Width="40" Height="40"
                                Padding="0">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource HubBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="21,20,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="/Metro/FriendsTitle" Text="друзья" FontFamily="Segoe UI" FontWeight="Light" FontSize="56"
                       Foreground="{ThemeResource HubForeground}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,10">
                <Button x:Name="SearchToggleButton"
                        Click="SearchToggle_Click"
                        Background="Transparent"
                        Foreground="{ThemeResource HubForeground}"
                        BorderThickness="0"
                        Width="44" Height="44"
                        Padding="0"
                        Margin="0,0,4,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="20"/>
                </Button>
                <Button x:Name="AddFriendButton"
                        Click="AddFriend_Click"
                        Background="Transparent"
                        Foreground="{ThemeResource HubForeground}"
                        BorderThickness="0"
                        Width="44" Height="44"
                        Padding="0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8FA;" FontSize="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="SearchBar" Grid.Row="1" Visibility="Collapsed" Margin="21,10,21,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     BorderThickness="2"
                     BorderBrush="{ThemeResource HubForeground}"
                     Background="Transparent"
                     Foreground="{ThemeResource HubForeground}"
                     FontSize="16"
                     TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1"
                    Click="CloseSearch_Click"
                    Background="Transparent"
                    Foreground="{ThemeResource HubForeground}"
                    BorderBrush="{ThemeResource HubForeground}"
                    BorderThickness="0,2,2,2"
                    Width="42"
                    VerticalAlignment="Stretch"
                    Padding="0">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="14"/>
            </Button>
        </Grid>

        <Pivot x:Name="PeoplePivot" Grid.Row="2" Margin="12,0,12,0" SelectedIndex="0">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontWeight="Light" FontSize="30"/>
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <PivotItem x:Uid="/Metro/FriendsTabOnline" Header="в сети" Margin="12,8,12,0">
                <ListView ItemsSource="{Binding Online}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                          ItemTemplate="{StaticResource PersonTemplate}" ItemContainerStyle="{StaticResource PersonItemStyle}"/>
            </PivotItem>
            <PivotItem x:Uid="/Metro/FriendsTabAll" Header="все" Margin="12,8,12,0">
                <ListView ItemsSource="{Binding All}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                          ItemTemplate="{StaticResource PersonTemplate}" ItemContainerStyle="{StaticResource PersonItemStyle}"/>
            </PivotItem>
            <PivotItem x:Uid="/Metro/FriendsTabRequests" Header="запросы" Margin="12,8,12,0">
                <ListView ItemsSource="{Binding Pending}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                          ItemTemplate="{StaticResource PendingTemplate}" ItemContainerStyle="{StaticResource PersonItemStyle}"/>
            </PivotItem>
            <PivotItem x:Uid="/Metro/FriendsTabBlocked" Header="заблокированные" Margin="12,8,12,0">
                <ListView ItemsSource="{Binding Blocked}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                          ItemTemplate="{StaticResource PersonTemplate}" ItemContainerStyle="{StaticResource PersonItemStyle}"/>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
