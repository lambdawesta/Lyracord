<Page
    x:Class="Unicord.Universal.Pages.StreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unicord.Universal.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <!-- Portrait: the bar on top, the video below. Landscape: full screen, the video fills everything and the bar
         lies over it; tapping the video shows or hides the bar (see StreamPage.ApplyOrientation). -->
    <Grid x:Name="Root" Background="Black" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <MediaPlayerElement x:Name="Player" Grid.Row="1" AreTransportControlsEnabled="False" Stretch="Uniform"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Tapped="Player_Tapped"/>

        <controls:SnakeLoader x:Name="Loading" Grid.Row="1" IsActive="True"/>

        <Grid x:Name="Bar" Background="#CC000000" Padding="10,6" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="2,0,8,0">
                <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusText" Foreground="#FFB9BBBE" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- voice mic / deafen + close -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="VoiceMuteToggle" Click="VoiceMute_Click" Foreground="White" Padding="10,8" Margin="2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEC54;" FontSize="16"/>
                </ToggleButton>
                <ToggleButton x:Name="VoiceDeafenToggle" Click="VoiceDeafen_Click" Foreground="White" Padding="10,8" Margin="2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74F;" FontSize="16"/>
                </ToggleButton>
                <Button x:Name="CloseButton" Click="Close_Click" Background="Transparent" Foreground="White" Padding="10,8" Margin="2,0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- stream volume -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MuteButton" Click="Mute_Click" Background="Transparent" Foreground="White" Padding="6,4">
                    <FontIcon x:Name="MuteIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="16"/>
                </Button>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                        Margin="6,0,4,0" ValueChanged="Volume_ValueChanged" Foreground="White"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
