<Page
    x:Class="Unicord.Universal.Pages.HubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:user="using:Unicord.Universal.Models.User"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <!-- Metro start hub (Windows Phone style): lowercase title, the signed-in profile where a search box would be,
         flat colour tiles, "recent" people and servers, plain buttons at the bottom.
         Square corners only; never Grid/Control.CornerRadius (1809+, phones run 1709). -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- true black for AMOLED screens -->
                    <SolidColorBrush x:Key="HubBackground" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HubForeground" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubSecondary" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="HubProfileBorder" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubPhotoBackground" Color="#FF262626"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HubBackground" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubForeground" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HubSecondary" Color="#FF6B6B6B"/>
                    <SolidColorBrush x:Key="HubProfileBorder" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HubPhotoBackground" Color="#FFE0E0E0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="HubSectionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="100"/>
                <Setter Property="Foreground" Value="{ThemeResource HubSecondary}"/>
                <Setter Property="Margin" Value="0,24,0,10"/>
            </Style>
            <Style x:Key="TileSmallStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#E6FFFFFF"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="TileBigStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontWeight" Value="SemiLight"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="HubButtonStyle" TargetType="Button">
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="FontSize" Value="18"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource HubBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,20,24,24" MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- title row -->
                <Grid Margin="0,0,0,20">
                    <TextBlock x:Uid="/Metro/HubTitle" Text="старт" FontFamily="Segoe UI" FontWeight="Light" FontSize="56"
                               Foreground="{ThemeResource HubForeground}" VerticalAlignment="Bottom" Margin="-3,0,0,0"/>
                    <TextBlock Text="LYRACORD" FontSize="14" FontWeight="SemiBold" CharacterSpacing="120"
                               Foreground="#FFE51400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,0,0"/>
                </Grid>

                <!-- the signed-in profile, framed like the search box of the Lumia start page -->
                <Border x:Name="ProfileBox" BorderThickness="2" BorderBrush="{ThemeResource HubProfileBorder}"
                        Padding="14" Tapped="Profile_Tapped" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="64" Height="64" Fill="#33808080"/>
                        <Ellipse Width="64" Height="64">
                            <Ellipse.Fill>
                                <ImageBrush Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <BitmapImage x:Name="AvatarImage" DecodePixelWidth="64" DecodePixelHeight="64" DecodePixelType="Logical"/>
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NameText" FontSize="22" FontFamily="Segoe UI" FontWeight="SemiLight"
                                           Foreground="{ThemeResource HubForeground}" TextTrimming="CharacterEllipsis"/>
                                <Border x:Name="GuildTagBorder"
                                        Grid.Column="1"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource GuildTagBackgroundBrush}"
                                        BorderBrush="{ThemeResource GuildTagBorderBrush}"
                                        BorderThickness="1"
                                        Padding="5,2,6,2"
                                        Margin="8,2,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="GuildTagIcon" Width="15" Height="15" Margin="0,0,4,0"
                                               VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed">
                                            <Image.Source>
                                                <BitmapImage x:Name="GuildTagBadgeImage" DecodePixelWidth="15" DecodePixelHeight="15" DecodePixelType="Logical"/>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock x:Name="GuildTagText"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   CharacterSpacing="50"
                                                   Foreground="{ThemeResource GuildTagForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="UsernameText" FontSize="14" Foreground="{ThemeResource HubSecondary}" TextTrimming="CharacterEllipsis"/>
                            <ItemsControl x:Name="BadgesList" Margin="-3,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="user:ProfileBadge">
                                        <Image Width="20" Height="20" Margin="3,0" ToolTipService.ToolTip="{x:Bind Description}">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind Icon}" DecodePixelWidth="20" DecodePixelHeight="20" DecodePixelType="Logical"/>
                                            </Image.Source>
                                        </Image>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Uid="/Metro/HubSections" Text="РАЗДЕЛЫ" Style="{StaticResource HubSectionStyle}"/>

                <!-- tiles: small label on top, big lowercase name at the bottom -->
                <Grid x:Name="TilesGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="110"/>
                    </Grid.RowDefinitions>

                    <!-- current call, only while connected to voice -->
                    <Grid x:Name="CallTile" Grid.ColumnSpan="3" Height="110" Margin="0,0,0,12" Visibility="Collapsed"
                          Background="#FF00ABA9" Tapped="Call_Tapped" Padding="16,12">
                        <TextBlock x:Name="CallLabel" x:Uid="/Metro/HubCallLabel" Text="в звонке" Style="{StaticResource TileSmallStyle}" Margin="0,0,32,0"/>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE717;" FontSize="20" Foreground="White"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <TextBlock x:Name="CallName" x:Uid="/Metro/HubCallName" Text="голосовой канал" Style="{StaticResource TileBigStyle}"/>
                        </Viewbox>
                    </Grid>

                    <Grid x:Name="StartTile" Grid.Row="1" Background="#FFA20025" Tapped="Start_Tapped" Padding="16,12">
                        <TextBlock x:Name="StartLabel" x:Uid="/Metro/HubStartSmall" Text="каналы и личные" Style="{StaticResource TileSmallStyle}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <TextBlock x:Uid="/Metro/HubStartBig" Text="начать" Style="{StaticResource TileBigStyle}"/>
                        </Viewbox>
                    </Grid>

                    <!-- flips between the name and a mosaic of friends who are online, like the People tile -->
                    <Grid x:Name="FriendsTile" Grid.Row="1" Grid.Column="2" Background="#FF1BA1E2" Tapped="Friends_Tapped">
                        <Grid.Projection>
                            <PlaneProjection x:Name="FriendsFlip"/>
                        </Grid.Projection>
                        <Grid x:Name="FriendsFront" Padding="16,12">
                            <TextBlock x:Name="FriendsLabel" x:Uid="/Metro/HubPeopleSmall" Text="люди" Style="{StaticResource TileSmallStyle}"/>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <TextBlock x:Uid="/Metro/HubFriendsBig" Text="друзья" Style="{StaticResource TileBigStyle}"/>
                            </Viewbox>
                        </Grid>
                        <Grid x:Name="FriendsBack" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </Grid>

                    <Grid x:Name="AboutTile" Grid.Row="3" Background="#FF008A00" Tapped="About_Tapped" Padding="16,12">
                        <TextBlock x:Name="VersionLabel" x:Uid="/Metro/HubVersionSmall" Text="версия" Style="{StaticResource TileSmallStyle}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <TextBlock x:Uid="/Metro/HubAboutBig" Text="о версии" Style="{StaticResource TileBigStyle}"/>
                        </Viewbox>
                    </Grid>

                    <Grid x:Name="SupportTile" Grid.Row="3" Grid.Column="2" Background="#FFD80073" Tapped="Support_Tapped" Padding="16,12">
                        <TextBlock x:Uid="/Metro/HubSoonSmall" Text="присоединиться к сообществу в telegram" Style="{StaticResource TileSmallStyle}" TextWrapping="Wrap" MaxLines="2"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <TextBlock x:Uid="/Metro/HubSupportBig" Text="поддержать" Style="{StaticResource TileBigStyle}"/>
                        </Viewbox>
                    </Grid>
                </Grid>

                <!-- recent conversations and servers, one tap straight into the chat -->
                <StackPanel x:Name="RecentSection" Visibility="Collapsed">
                    <TextBlock x:Uid="/Metro/HubRecent" Text="НЕДАВНИЕ" Style="{StaticResource HubSectionStyle}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Margin="0,0,-24,0">
                        <StackPanel x:Name="RecentList" Orientation="Horizontal"/>
                    </ScrollViewer>
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource HubSecondary}" Opacity="0.4" Margin="0,24,0,16"/>

                <!-- plain buttons, like the Lumia start page -->
                <toolkit:WrapPanel>
                    <Button x:Uid="/Metro/HubEditProfile" Content="изменить профиль" Style="{StaticResource HubButtonStyle}" Click="EditProfile_Click"/>
                    <Button x:Name="TileColorButton" x:Uid="/Metro/HubTileColor" Content="цвет плиток" Style="{StaticResource HubButtonStyle}" Click="TileColor_Click"/>
                    <Button x:Uid="/Metro/HubSettings" Content="настройки" Style="{StaticResource HubButtonStyle}" Click="Settings_Click"/>
                </toolkit:WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
