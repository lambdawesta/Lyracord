<Page
    x:Class="Unicord.Universal.Pages.AboutHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- "о версии" in the Metro style: version, what is new, acknowledgements. Only built-in resources, so it opens on
         the phone where the old settings pages fail to parse. Square corners only. -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HubBackground" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HubForeground" Color="#FFFFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HubBackground" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubForeground" Color="#FF000000"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource HubBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,20,24,24" MaxWidth="720" HorizontalAlignment="Stretch">
                <TextBlock x:Uid="/Metro/AboutTitle" Text="о версии" FontFamily="Segoe UI" FontWeight="Light" FontSize="56"
                           Foreground="{ThemeResource HubForeground}" Margin="-3,0,0,12"/>
                <StackPanel x:Name="Items"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
