<UserControl
    x:Class="Unicord.Universal.Dialogs.ProfileOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unicord.Universal.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:guild="using:Unicord.Universal.Models.Guild"
    xmlns:user="using:Unicord.Universal.Models.User"
    x:DefaultBindMode="OneWay" mc:Ignorable="d" MaxWidth="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ProfileBg" Color="#FF000000"/>
                    <SolidColorBrush x:Key="ProfileHeaderBg" Color="#FF000000"/>
                    <SolidColorBrush x:Key="ProfileFg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ProfileSecondary" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="ProfileLine" Color="#FF262626"/>
                    <SolidColorBrush x:Key="ProfilePhotoBg" Color="#FF1F1F1F"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ProfileBg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ProfileHeaderBg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ProfileFg" Color="#FF000000"/>
                    <SolidColorBrush x:Key="ProfileSecondary" Color="#FF6B6B6B"/>
                    <SolidColorBrush x:Key="ProfileLine" Color="#FFE0E0E0"/>
                    <SolidColorBrush x:Key="ProfilePhotoBg" Color="#FFE0E0E0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ProfileSectionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="100"/>
                <Setter Property="Foreground" Value="{ThemeResource ProfileSecondary}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Windows Phone Metro People-style profile card: pure black/white AMOLED background, square avatar with status bar,
         Segoe UI Light typography, flat hairline sections, sharp corners everywhere (no Grid/Control.CornerRadius). -->
    <Border Background="{ThemeResource ProfileBg}">
        <ScrollViewer x:Name="ProfileScroll"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="0,0,0,72">
                <!-- Banner -->
                <Grid x:Name="BannerHost" Height="136" Background="{ThemeResource ProfilePhotoBg}">
                    <Image x:Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="CloseOverlayButton"
                            Click="CloseOverlayButton_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="12,12,12,0"
                            Padding="10,8"
                            MinWidth="38"
                            MinHeight="38"
                            Background="#80000000"
                            Foreground="White"
                            BorderThickness="0">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BB;" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- Header: square avatar overlapping banner + badges + Metro light DisplayName + square server tag -->
                <Border x:Name="HeaderBorder" Background="{ThemeResource ProfileHeaderBg}">
                    <Grid Padding="20,0,20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Square Metro avatar with 4px frame in card colour and left 4px status bar -->
                        <Border x:Name="AvatarFrame"
                                Margin="-4,-48,0,0"
                                BorderThickness="4"
                                BorderBrush="{ThemeResource ProfileHeaderBg}"
                                Background="{ThemeResource ProfilePhotoBg}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <Grid Width="92" Height="92">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage x:Name="AvatarBitmap" DecodePixelWidth="96" DecodePixelHeight="96" DecodePixelType="Logical"/>
                                    </Image.Source>
                                </Image>
                                <Rectangle x:Name="StatusBar" Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Badges right of the avatar -->
                        <ItemsControl x:Name="BadgesList" Grid.Column="1" Margin="14,10,0,0"
                                      HorizontalAlignment="Right" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <toolkit:WrapPanel Orientation="Horizontal" HorizontalSpacing="4" VerticalSpacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="user:ProfileBadge">
                                    <Image Width="22" Height="22" ToolTipService.ToolTip="{x:Bind Description}">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Icon}" DecodePixelWidth="22" DecodePixelHeight="22" DecodePixelType="Logical"/>
                                        </Image.Source>
                                    </Image>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- DisplayName + square Metro server tag + username/pronouns -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DisplayNameText"
                                           FontFamily="Segoe UI"
                                           FontWeight="Light"
                                           FontSize="30"
                                           Foreground="{ThemeResource ProfileFg}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Text="{x:Bind User.DisplayName, TargetNullValue=''}"/>
                                <Border x:Name="GuildTagBorder"
                                        Grid.Column="1"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource GuildTagBackgroundBrush}"
                                        BorderBrush="{ThemeResource GuildTagBorderBrush}"
                                        BorderThickness="1"
                                        Padding="5,2,6,2"
                                        Margin="10,4,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="GuildTagIcon" Width="16" Height="16" Margin="0,0,4,0"
                                               VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed">
                                            <Image.Source>
                                                <BitmapImage x:Name="GuildTagBadgeImage" DecodePixelWidth="16" DecodePixelHeight="16" DecodePixelType="Logical"/>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock x:Name="GuildTagText"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   CharacterSpacing="50"
                                                   Foreground="{ThemeResource GuildTagForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="UsernameText" FontSize="14" Foreground="{ThemeResource ProfileSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock x:Name="NitroText" Visibility="Collapsed" Margin="0,2,0,0" FontSize="12" Foreground="{ThemeResource ProfileSecondary}"/>
                        </StackPanel>

                        <!-- Flat Metro action row -->
                        <toolkit:WrapPanel x:Name="ActionsPanel" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                                           HorizontalSpacing="10" VerticalSpacing="8" Margin="0,14,0,0">
                            <Button x:Name="MessageButton"
                                    Click="MessageButton_Click"
                                    Background="Transparent"
                                    Foreground="{ThemeResource ProfileFg}"
                                    BorderBrush="{ThemeResource ProfileFg}"
                                    BorderThickness="2"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BD;" FontSize="15" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MessageButtonText" Text="написать" FontSize="15" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CallButton"
                                    Click="CallButton_Click"
                                    Background="Transparent"
                                    Foreground="{ThemeResource ProfileFg}"
                                    BorderBrush="{ThemeResource ProfileFg}"
                                    BorderThickness="2"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE717;" FontSize="15" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CallButtonText" Text="позвонить" FontSize="15" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FriendButton"
                                    Click="FriendButton_Click"
                                    Background="Transparent"
                                    Foreground="{ThemeResource ProfileFg}"
                                    BorderBrush="{ThemeResource ProfileFg}"
                                    BorderThickness="2"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon x:Name="FriendButtonIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE8FA;" FontSize="15" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FriendButtonText" Text="добавить" FontSize="15" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </toolkit:WrapPanel>
                    </Grid>
                </Border>

                <!-- About me -->
                <StackPanel x:Name="BioPanel" Visibility="Collapsed" Padding="20,14,20,14"
                            BorderThickness="0,1,0,0" BorderBrush="{ThemeResource ProfileLine}">
                    <TextBlock x:Uid="/Metro/ProfileAboutMe" Text="ОБО МНЕ" Style="{StaticResource ProfileSectionStyle}"/>
                    <TextBlock x:Name="BioText" FontSize="14" Foreground="{ThemeResource ProfileFg}" TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxLines="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Live activities from Gateway presence -->
                <StackPanel x:Name="CurrentActivityPanel" Visibility="Collapsed" Padding="20,14,20,14"
                            BorderThickness="0,1,0,0" BorderBrush="{ThemeResource ProfileLine}">
                    <TextBlock x:Name="CurrentActivityHeader" Text="АКТИВНОСТЬ" Style="{StaticResource ProfileSectionStyle}"/>
                    <StackPanel x:Name="CurrentActivityList"/>
                </StackPanel>

                <!-- Recent activity ("Недавно играл в…") from Discord content-inventory -->
                <StackPanel x:Name="RecentActivityPanel" Visibility="Collapsed" Padding="20,14,20,14"
                            BorderThickness="0,1,0,0" BorderBrush="{ThemeResource ProfileLine}">
                    <TextBlock x:Name="RecentActivityHeader" Text="НЕДАВНО ИГРАЛ(А)" Style="{StaticResource ProfileSectionStyle}"/>
                    <StackPanel x:Name="RecentActivityList"/>
                </StackPanel>

                <!-- Profile game widgets -->
                <StackPanel x:Name="WidgetsPanel" Visibility="Collapsed" Padding="20,14,20,14"
                            BorderThickness="0,1,0,0" BorderBrush="{ThemeResource ProfileLine}">
                    <StackPanel x:Name="WidgetsList"/>
                </StackPanel>

                <!-- Metro Pivot: server / mutual servers / connections -->
                <Grid Padding="8,4,8,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource ProfileLine}">
                    <Pivot SelectedIndex="0">
                        <Pivot.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontWeight="Light" FontSize="26" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </Pivot.HeaderTemplate>
                        <PivotItem x:Name="guildOverlay" x:Load="{x:Bind User.IsMember, Mode=OneTime}" Header="{x:Bind User.Guild.Name}" Margin="12,8,12,0">
                            <StackPanel Padding="0,0,0,8">
                                <StackPanel x:Name="rolesList"
                                            Visibility="{x:Bind User.Roles, Converter={StaticResource BoolVisibilityConverter}}">
                                    <TextBlock x:Uid="/Dialogs/ProfileRoles" Style="{StaticResource ProfileSectionStyle}"/>
                                    <ItemsControl ItemTemplate="{StaticResource RoleTemplate}" ItemsSource="{x:Bind User.Roles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <toolkit:WrapPanel VerticalSpacing="4" HorizontalSpacing="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock x:Uid="/Dialogs/ProfileJoinedServer" Style="{StaticResource ProfileSectionStyle}" Margin="0,14,0,4"/>
                                <TextBlock FontSize="14" Foreground="{ThemeResource ProfileFg}" Text="{x:Bind User.JoinedAt, Converter={StaticResource DateTimeConverter}}"/>
                            </StackPanel>
                        </PivotItem>
                        <PivotItem x:Uid="/Dialogs/ProfileMutualServers" Margin="12,8,12,0">
                            <PivotItem.Content>
                                <ItemsControl x:Name="mutualServers" Margin="0,4,0,8" ItemsSource="{x:Bind User.MutualGuilds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="guild:GuildViewModel">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="40" Height="40" Background="{ThemeResource ProfilePhotoBg}">
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{x:Bind Name}" FontFamily="Segoe UI" FontWeight="SemiLight" FontSize="18" Foreground="{ThemeResource ProfileFg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </PivotItem.Content>
                        </PivotItem>
                        <PivotItem x:Uid="/Dialogs/ProfileConnections" Margin="12,8,12,0">
                            <StackPanel x:Name="ConnectionsPanel" Margin="0,4,0,8"/>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
